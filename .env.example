# Copy to .env and fill in. Unset groups disable that feature gracefully.

# --- Jira (optional; dry-run if unset) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT=SKILL

# --- LLM reviewer: Claude on Azure AI Foundry (native Anthropic Messages API) ---
# Foundry serves Claude at <base>/anthropic/v1/messages. Give either the base
# or the full messages URL; the /v1/messages suffix is added if missing.
# Do NOT add an api-version param and do NOT use an /openai path (those 404).
SKILLGATE_LLM_ENDPOINT=https://matth-mbppp40b-eastus2.services.ai.azure.com/anthropic
SKILLGATE_LLM_API_KEY=your-foundry-deployment-key
# This is the Foundry DEPLOYMENT NAME you chose, not a dated model id.
SKILLGATE_LLM_MODEL=your-claude-deployment-name
SKILLGATE_LLM_ANTHROPIC_VERSION=2023-06-01
SKILLGATE_LLM_MAX_TOKENS=1024

# --- Cisco scanner LLM layer (optional) ---
SKILL_SCANNER_LLM_API_KEY=

# --- scan worker ---
SKILLGATE_SCAN_MODE=subprocess          # or: container
SKILLGATE_SCANNER_IMAGE=skillgate-scanner:latest
